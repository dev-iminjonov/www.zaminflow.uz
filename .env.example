# ==============================================================================
# ZaminFlow v2.0 — Environment Configuration Template (.env.example)
# Copy to .env (`cp .env.example .env`) and set secret values before deployment.
# ==============================================================================

# 1. Database Configuration (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_USER=dairy_user
POSTGRES_PASSWORD=
POSTGRES_DB=dairy_platform
DATABASE_URL=

# 2. Security & Cryptographic Secrets (Generate 32+ byte random strings)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_SECRET=
QR_HMAC_SECRET=
BANK_WEBHOOK_HMAC_SECRET=

# Optional local-only demo account passwords (never set these for production)
SEED_FARMER_PASSWORD=
SEED_DAIRY_PASSWORD=
SEED_DRIVER_PASSWORD=
SEED_ADMIN_PASSWORD=

# 3. Email / SMTP Configuration (Leaves console fallback active if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@zaminflow.uz

# 4. Backend Application Settings
SUPABASE_URL=
APP_BASE_URL=http://localhost:3000
KYB_DOCS_DIR=/tmp/kyb_docs

# 5. Frontend & Ingress Settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK_DATA=true
DOMAIN=localhost
