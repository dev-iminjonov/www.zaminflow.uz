# Database Configuration (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_USER=dairy_user
POSTGRES_PASSWORD=dairy_secret_password
POSTGRES_DB=dairy_platform
DATABASE_URL=postgresql+asyncpg://dairy_user:dairy_secret_password@localhost:5432/dairy_platform

# Security & Cryptographic Secrets
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_SECRET=super-secret-csrf-token-key-change-in-production-32bytes
QR_HMAC_SECRET=super-secret-qr-hmac-signing-key-2026
BANK_WEBHOOK_HMAC_SECRET=partner-bank-webhook-hmac-secret-2026

# Email / SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@zaminflow.uz

# App Configuration
APP_BASE_URL=http://localhost:3000
KYB_DOCS_DIR=/tmp/kyb_docs

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
DOMAIN=localhost
